  },
  "item": [
    {
      "name": "Create Gists",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const res = pm.response.json();",
              "pm.environment.set(\"gistId\", res.id);",
              "pm.test(\"Status is 201 Created\", () => pm.response.to.have.status(201));"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"description\": \"QA Exploration Gist\",\n  \"public\": false,\n  \"files\": {\n    \"notes.txt\": {\n      \"content\": \"Testing GitHub Gist API manually via Postman.\"\n    },\n    \"config.json\": {\n      \"content\": \"{\\\"env\\\": \\\"staging\\\", \\\"debug\\\": true}\"\n    }\n  }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/gists",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "gists"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Get Gists",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status is 200 OK\", () => pm.response.to.have.status(200));",
              "pm.test(\"Contains requested files\", () => {",
              "    const res = pm.response.json();",
              "    pm.expect(res.files[\"notes.txt\"]).to.exist;",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/gists/{{gistId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "gists",
            "{{gistId}}"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Patch Gists",
      "request": {
        "method": "PATCH",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"description\": \"Updated QA Exploration Gist\",\n  \"files\": {\n    \"notes.txt\": {\n      \"content\": \"Updated content via PATCH request.\"\n    },\n    \"config.json\": null\n  }\n}",
          "options": {
            "raw": {
              "language": "json"
