# Copy to .env and fill in. NEVER commit .env.
#
# Two GitHub accounts are required. Account A owns the gists under test;
# account B proves that cross-user writes are rejected. A third persona
# (anonymous, no token) is exercised by the suite with no configuration.
#
# Token creation:
#   Settings -> Developer settings -> Personal access tokens -> Fine-grained tokens
#   Account permissions -> Gists: Read and write
#   Expiry: 7 days
# A classic token with the `gist` scope also works.

# --- Required ---
# GITHUB_TOKEN_A / GITHUB_TOKEN_B are accepted as aliases. GIST_* is canonical
# because GitHub Actions reserves the GITHUB_ prefix for its own variables.
GIST_TOKEN_A=
GIST_TOKEN_B=

# --- Optional ---
# Logins are resolved from GET /user at runtime when these are omitted.
# Set them to save one API call per worker.
GIST_USERNAME_A=
GIST_USERNAME_B=

# --- Optional overrides ---
BASE_URL=https://api.github.com
API_VERSION=2026-03-10

# Set to 1 to print x-ratelimit-* headers after every request.
LOG_RATE_LIMIT=0

# Zone used for the local time shown beside every UTC timestamp the suite prints.
# An IANA name, e.g. Europe/Berlin. Defaults to the machine's own zone; on a CI
# runner that is UTC, and the local half is then omitted rather than duplicated.
REPORT_TIMEZONE=

# --- Write budget (findings #23) ---
# GitHub caps content creation at 80 requests/min, and REST at 900 points/min
# (a write costs 5, a read 1). A full run makes ~170 writes, so the suite paces
# them; unpaced it exceeds both caps within a single run and the account is
# temporarily blocked from creating content.
#
# These two are a pair. The budget below is account-wide, and each worker is a
# separate process enforcing 1/PW_WORKERS of it — so raising the workers without
# touching the rate speeds nothing up, and raising the rate is what buys a faster
# run, at the cost of the margin under 80. Lower the rate if a run is throttled
# despite this; do not raise it above 80.
PW_WORKERS=4
WRITE_RATE_PER_MIN=70

# Back-off retries for a request that comes back throttled anyway (403 secondary,
# 429, or the 409 GitHub returns for a PATCH too soon after the previous one).
THROTTLE_RETRIES=2