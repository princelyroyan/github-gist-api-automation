# Copy to .env and fill in. NEVER commit .env.
#
# Two GitHub accounts are required. Account A owns the gists under test;
# account B proves that cross-user writes are rejected. A third persona
# (anonymous, no token) is exercised by the suite with no configuration.
#
# Token creation:
#   Settings -> Developer settings -> Personal access tokens -> Fine-grained tokens
#   Account permissions -> Gists: Read and write
#   Expiry: 7 days
# A classic token with the `gist` scope also works.

# --- Required ---
# GITHUB_TOKEN_A / GITHUB_TOKEN_B are accepted as aliases. GIST_* is canonical
# because GitHub Actions reserves the GITHUB_ prefix for its own variables.
GIST_TOKEN_A=
GIST_TOKEN_B=

# --- Optional ---
# Logins are resolved from GET /user at runtime when these are omitted.
# Set them to save one API call per worker.
GIST_USERNAME_A=
GIST_USERNAME_B=

# --- Optional overrides ---
BASE_URL=https://api.github.com
API_VERSION=2026-03-10

# Set to 1 to print x-ratelimit-* headers after every request.
LOG_RATE_LIMIT=0